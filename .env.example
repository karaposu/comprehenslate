# Comprehenslate Configuration

# Enable Phase 1 comprehension & indexing (true/false)
INDEXING_ENABLED=true

# Enable harmony preservation layer (true/false)
HARMONY_ENABLED=false

# Target audience: native | late_learner | late_learner_simple
AUDIENCE_LEVEL=native

# Poetic translation mode (true/false)
POETIC_MODE=false

# Quoted content handling: leave | translate | translate_and_preserve
QUOTED_CONTENT=translate_and_preserve

# Analysis depth: surface | standard | deep | scholarly
DEPTH_PROFILE=standard

# Chunking: semantic_chapter | semantic_section | semantic_page | heuristic_overlapping
CHUNKING_STRATEGY=semantic_section

# Parallel processing: none | chapter_threaded | naive
PARALLEL_MODE=none

# Output: md | pdf
OUTPUT_FORMAT=md

# Preserve source document formatting (true/false)
PRESERVE_ORIGINAL_FORMAT=false
